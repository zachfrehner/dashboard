[Unit]
Description=BurnMetrix Dashboard Chromium Kiosk
After=graphical.target burnmetrix-backend.service
Wants=burnmetrix-backend.service

[Service]
Type=simple
User=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
ExecStart=/usr/bin/chromium-browser --noerrdialogs --disable-infobars --disable-application-cache --disk-cache-size=1 --media-cache-size=1 --user-data-dir=/home/pi/.config/burnmetrix-kiosk --kiosk --app=http://localhost
Restart=no

[Install]
WantedBy=graphical.target
